# Application
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database (Supabase PostgreSQL; use the asyncpg-compatible connection string)
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?ssl=require
REDIS_URL=redis://localhost:6379/0

# Authentication configuration (use a long random value outside development)
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=adveno
JWT_AUDIENCE=adveno-api

# Device operational defaults
PAIRING_TOKEN_TTL_SECONDS=300
HEARTBEAT_TIMEOUT_SECONDS=120
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# BFF OAuth (Supabase Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
MEDIA_STORAGE_BUCKET=media
OAUTH_PROVIDER=google
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
OAUTH_STATE_TTL_SECONDS=600
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_NAME=adveno_session
SESSION_COOKIE_SECURE=false
FRONTEND_AFTER_LOGIN_URL=http://localhost:3000/login
